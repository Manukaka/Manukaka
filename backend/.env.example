# Copy to .env and fill in. NEVER commit the real .env.
ANTHROPIC_API_KEY=sk-ant-...

# Model routing (optional overrides)
MANU_MODEL_FAST=claude-haiku-4-5-20251001
MANU_MODEL_SMART=claude-sonnet-5

# Cost / safety caps (optional)
MANU_MAX_STEPS=40
MANU_MAX_TOKENS=1024
MANU_RATE_LIMIT_REQUESTS=120
MANU_RATE_LIMIT_WINDOW=60

# Shared secret the app must send as the X-Manu-Key header.
# Leave empty for local dev; set a long random value before exposing publicly.
MANU_APP_SHARED_SECRET=

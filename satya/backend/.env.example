# Copy to .env and fill in. The backend reads these at startup.

# Required: your Claude API key (kept server-side, never shipped in the app).
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown).
SATYA_MODEL=claude-opus-4-8
SATYA_EFFORT=medium
SATYA_MAX_TOKENS=2000
SATYA_WEB_SEARCH_MAX_USES=5
SATYA_CACHE_TTL_HOURS=72
SATYA_PORT=8000
# Comma-separated CORS origins for the app; lock this down in production.
SATYA_CORS_ORIGINS=*
